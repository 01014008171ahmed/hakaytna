(function(){const dates=['اختاروا فيلم بتحبوه، وحضّروا سناكس واتفرجوا سوا.','اعملوا بلاي ليست: كل واحد يختار ٣ أغاني بتفكره بالتاني.','اتمشّوا شوية، وكل واحد يحكي أحلى حاجة حصلتله الأسبوع ده.','حضّروا مشروب بتحبوه واقعدوا تحكوا من غير موبايلات نص ساعة.','اختاروا أكلة جديدة وجربوا تحضّروها سوا.','اعملوا تحدّي تصوير: كل واحد يصوّر ٣ حاجات فكرته بالتاني.','ارسموا بعض في دقيقتين وقارنوا النتيجة، حتى لو الرسم مضحك!','اكتبوا ٣ حاجات نفسكم تعملوها سوا في المستقبل.'];const questions=['إيه لحظة بسيطة خلتك تبتسم النهارده؟','إيه أغنية بتفكرك بيا وليه؟','لو هنقضي يوم كامل سوا من غير أي التزامات، نفسك نعمل إيه؟','إيه أكتر حاجة صغيرة بتحسسك بالاهتمام؟','إيه مكان نفسك نزوره سوا يومًا ما؟','إيه أكتر حاجة بتحبها في طريقة كلامنا مع بعض؟','لو وصفت علاقتنا بكلمة واحدة، هتختار إيه؟','إيه حاجة جديدة نفسك نتعلمها مع بعض؟','إيه ذكرى بتحب تفتكرها لما تكون محتاج تبتسم؟'];let di=0,qi=0;document.getElementById('nextDate').addEventListener('click',()=>{di=(di+1)%dates.length;document.getElementById('dateIdea').textContent=dates[di]});document.getElementById('nextQuestion').addEventListener('click',()=>{qi=(qi+1)%questions.length;document.getElementById('questionText').textContent=questions[qi]})})();
</script><section class="section play" id="games"><div class="game-heading"><div class="overline">شوية لعب وضحك</div><h2>يلا نلعب سوا ♡</h2><p class="lead">لعبتين خفاف على نفس الجهاز، ومفيش غير كسبانين لما الوقت يبقى حلو.</p></div><div class="game-wrap"><article class="game-card"><h3>لمّوا القلوب</h3><p>اقلبوا كارتين في كل مرة، وحاولوا تلاقوا كل شكلين زي بعض.</p><div class="game-status" id="memoryStatus" aria-live="polite">المحاولات: ٠ · الأزواج: ٠ من ٦</div><div class="memory-grid" id="memoryGrid" aria-label="لعبة الذاكرة"></div><div class="game-actions"><button class="secondary" id="memoryReset">العبوا من جديد ↻</button></div></article><article class="game-card"><h3>إكس وأو بالحب</h3><p>اتبادلوا الأدوار على نفس الجهاز. أول واحد يكمّل تلاتة يكسب!</p><div class="game-status" id="xoStatus" aria-live="polite">دور ♡</div><div class="xo-grid" id="xoGrid" aria-label="لعبة إكس وأو"></div><div class="game-actions"><button class="secondary" id="xoReset">جولة جديدة ↻</button></div></article></div></section><script>
(function(){const mg=document.getElementById('memoryGrid'),ms=document.getElementById('memoryStatus');const symbols=['♥','☾','✿','✦','☀','♫'];let deck=[],open=[],pairs=0,tries=0,lock=false,timer=null;function memoryStart(){clearTimeout(timer);deck=[...symbols,...symbols].map((v,i)=>({v,id:i}));for(let i=deck.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]]}open=[];pairs=0;tries=0;lock=false;mg.replaceChildren();ms.textContent='المحاولات: ٠ · الأزواج: ٠ من ٦';deck.forEach((card,i)=>{let b=document.createElement('button');b.type='button';b.className='memory-tile';b.textContent='؟';b.setAttribute('aria-label','كارت رقم '+(i+1));b.addEventListener('click',()=>{if(lock||b.classList.contains('open')||b.classList.contains('matched'))return;b.textContent=card.v;b.classList.add('open');b.setAttribute('aria-label','كارت '+card.v);open.push({b,card});if(open.length===2){tries++;if(open[0].card.v===open[1].card.v){open.forEach(x=>{x.b.classList.remove('open');x.b.classList.add('matched');x.b.disabled=true});pairs++;open=[];ms.textContent=pairs===6?'برافو! لقيتوا كل الأزواج في '+tries+' محاولة ♡':'المحاولات: '+tries+' · الأزواج: '+pairs+' من ٦'}else{lock=true;ms.textContent='المحاولات: '+tries+' · الأزواج: '+pairs+' من ٦';timer=setTimeout(()=>{open.forEach(x=>{x.b.classList.remove('open');x.b.textContent='؟';x.b.setAttribute('aria-label','كارت مقلوب')});open=[];lock=false},850)}}});mg.appendChild(b)})}document.getElementById('memoryReset').addEventListener('click',memoryStart);memoryStart();
const xg=document.getElementById('xoGrid'),xs=document.getElementById('xoStatus');let board=[],turn='♡',done=false;const wins=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];function xoStart(){board=Array(9).fill('');turn='♡';done=false;xg.replaceChildren();xs.textContent='دور ♡';board.forEach((_,i)=>{const b=document.createElement('button');b.type='button';b.className='xo-cell';b.setAttribute('aria-label','خانة '+(i+1));b.addEventListener('click',()=>{if(done||board[i])return;board[i]=turn;b.textContent=turn;b.setAttribute('aria-label','خانة '+(i+1)+' '+turn);b.disabled=true;if(wins.some(line=>line.every(n=>board[n]===turn))){done=true;xs.textContent=turn+' كسب! جولة حلوة ♡'}else if(board.every(Boolean)){done=true;xs.textContent='تعادل! واضح إنكم متفاهمين ♡'}else{turn=turn==='♡'?'✕':'♡';xs.textContent='دور '+turn}});xg.appendChild(b)})}document.getElementById('xoReset').addEventListener('click',xoStart);xoStart()})();
